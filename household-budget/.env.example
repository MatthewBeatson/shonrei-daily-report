# Copy to .env (same folder) for local use. In production set these in the
# host's environment settings instead -- never commit real values.

# --- Bank feed (Akahu) -------------------------------------------------------
# From https://my.akahu.nz/developers -> your Personal App. Both are secrets:
# together they give READ-ONLY access to the accounts you connected in Akahu.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=
# How often to pull new transactions, and how far back the first sync goes.
SYNC_INTERVAL_MINUTES=30
SYNC_BACKFILL_DAYS=180

# --- Server -----------------------------------------------------------------
PORT=3100
# Where the SQLite database lives. On Render, point this at the mounted disk
# (e.g. /var/data/budget.db) or everything is lost on each deploy.
DB_PATH=
# Set to false ONLY for local http://localhost testing.
COOKIE_SECURE=true
# Number of proxies in front of the app (Render/Fly/Cloudflare = 1).
TRUST_PROXY=1
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=168
