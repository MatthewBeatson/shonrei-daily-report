# Same Supabase project as the ordering-portal repo (project ref vwbbkkwzehkfhurhluza).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler connection (NOT the direct db.<ref>.supabase.co host — see
# ordering-portal's notes; the direct host is IPv6-only and fails from most
# dev/CI environments).
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.vwbbkkwzehkfhurhluza
SUPABASE_DB_PASSWORD=

# Shared secret between the Node backend and the Python refresh service.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REFRESH_SHARED_SECRET=
