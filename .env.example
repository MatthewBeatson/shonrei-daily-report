# This app's own Supabase project (project ref zkwbapuclczezoxxtevk) --
# NOT the same project as the ordering-portal repo (that one is
# vwbbkkwzehkfhurhluza). This README/example used to claim they were
# shared; that was wrong/stale as of 2026-09-03 and has been corrected.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler connection (NOT the direct db.<ref>.supabase.co host --
# that host is IPv6-only and fails from most dev/CI environments).
SUPABASE_DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.zkwbapuclczezoxxtevk
SUPABASE_DB_PASSWORD=

# Shared secret between the Node backend and the Python refresh service.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REFRESH_SHARED_SECRET=
